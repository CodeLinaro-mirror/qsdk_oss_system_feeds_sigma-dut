From 29d7d7411d74ddd136f880af4a30d508bc04da60 Mon Sep 17 00:00:00 2001
From: Naveen S <quic_naves@quicinc.com>
Date: Wed, 4 Sep 2024 23:03:44 +0530
Subject: [PATCH] sigma_dut: Restructure ap_set_refeature

In channel switch, the swapped link id will
be used in hostapd_cli earlier, now removing
the swapping part as it has been handled correctly
now.

Signed-off-by: Dhanavandhana Kannan <quic_dhanavan@quicinc.com>
Signed-off-by: Naveen S <quic_naves@quicinc.com>
---
 ap.c | 12 +++---------
 1 file changed, 3 insertions(+), 9 deletions(-)

--- a/ap.c
+++ b/ap.c
@@ -17757,7 +17757,6 @@ static int mac80211_chnum_band(struct si
 	char link_param[10];
 	int res;
 	bool link_set = false;
-	int link = 0;
 
 	/* Extract the channel info */
 	token = strdup(val);
@@ -17773,12 +17772,7 @@ static int mac80211_chnum_band(struct si
 		chwidth = atoi(result);
 
 	if (dut->num_links > 1) {
-		if (link_id == 0)
-			link = 1;
-		else
-			link = 0;
-
-		center_freq_idx = get_oper_centr_freq_seq_idx(dut, chwidth, channel, link);
+		center_freq_idx = get_oper_centr_freq_seq_idx(dut, chwidth, channel, link_id);
 	} else {
 		center_freq_idx = get_oper_centr_freq_seq_idx(dut, chwidth, channel, 0);
 	}
@@ -17793,7 +17787,7 @@ static int mac80211_chnum_band(struct si
 	else
 		sec_ch_offset = 1;
 
-	if (check_band(dut, BAND_2G, link)) {
+	if (check_band(dut, BAND_2G, link_id)) {
 		if (chwidth == 40) {
 			if (channel < 7)
 				sec_ch_offset = 1;
@@ -17802,7 +17796,7 @@ static int mac80211_chnum_band(struct si
 		}
 		center_freq = get_2g_channel_freq(center_freq_idx);
 		channel_freq = get_2g_channel_freq(channel);
-	} else if (check_band(dut, BAND_6G, link)) {
+	} else if (check_band(dut, BAND_6G, link_id)) {
 		if (chwidth != 20) {
 			if (((channel - 1) / 4) % 2)
 				sec_ch_offset = -1;
@@ -18454,7 +18448,7 @@ static enum sigma_cmd_result mac80211_he
 	int ret = -1;
 	int ltf = -1, gi = -1;
 
-	if (dut->ap_is_dual && dut->ap_mode == AP_11be) {
+	if (dut->ap_is_dual && dut->mld[link_id].ap_mode == AP_11be) {
 		if (link_id == dut->band_to_link[0])
 			mode = "2.4";
 		else if (link_id == dut->band_to_link[1])
@@ -18668,7 +18662,7 @@ static enum sigma_cmd_result mac80211_eh
 			fwtest_linkid_cmd_wrapper(dut, "-m 0x4b -v 0 40 0 996", ifname, linkid);
 			fwtest_linkid_cmd_wrapper(dut, "-m 0x4b -v 0 41 0 996", ifname, linkid);
 		} else if (val_bw >= AP_160) {
-			if (dut->ap_chwidth == AP_320) {
+			if (dut->mld[linkid].ap_chwidth == AP_320) {
 				fwtest_linkid_cmd_wrapper(dut,
 							  "-m 0x4b -v 0 40 0 996 1 996 2 996 3 996",
 							  ifname, linkid);
@@ -18688,7 +18682,7 @@ static enum sigma_cmd_result mac80211_eh
 		}
 	} else if (value == EHT_RU_ALLOC_2) {
 		if (val_bw == AP_160) {
-			if (dut->ap_chwidth == AP_320) {
+			if (dut->mld[linkid].ap_chwidth == AP_320) {
 				fwtest_linkid_cmd_wrapper(dut, "-m 0x4b -v 0 40 0 1992 1 1992",
 							  ifname, linkid);
 				fwtest_linkid_cmd_wrapper(dut, "-m 0x4b -v 0 41 0 1992 1 1992",
@@ -19126,7 +19120,7 @@ static enum sigma_cmd_result mac80211_ap
 	val = get_param(cmd, "CodingType");
 	if (val) {
 		if (strcasecmp(val, "BCCCoding") == 0 && dut->program == PROGRAM_EHT) {
-			if (dut->ap_mode == AP_11be) {
+			if (dut->mld[link_id].ap_mode == AP_11be) {
 				if (dut->ap_fixed_rate) {
 					dut->ap_bcc = VALUE_ENABLED;
 					dut->ap_ldpc = VALUE_DISABLED;
@@ -19139,7 +19133,7 @@ static enum sigma_cmd_result mac80211_ap
 							  "-t 1 -m 0x00 -v 0  0x8A 0",
 							  ifname, link_id);
 		} else if (strcasecmp(val, "LDPCCoding") == 0 && dut->program == PROGRAM_EHT) {
-			if (dut->ap_mode == AP_11be) {
+			if (dut->mld[link_id].ap_mode == AP_11be) {
 				if (dut->ap_fixed_rate)
 					dut->ap_ldpc = VALUE_ENABLED;
 				else
