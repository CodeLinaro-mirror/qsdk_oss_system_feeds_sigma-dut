From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Priyadharshini Gowthaman <pgowtham@qti.qualcomm.com>
Date: Tue, 18 Aug 2026 17:35:07 -0700
Subject: [PATCH] UPSTREAM:PROTOCOL: sigma_dut: Apply nss mcs cap MCS as UHR auto rate cap

Signed-off-by: Priyadharshini Gowthaman <pgowtham@qti.qualcomm.com>
---
diff --git a/ap.c b/ap.c
index 7886c50..2c86c92 100644
--- a/ap.c
+++ b/ap.c
@@ -1982,6 +1982,8 @@ static enum sigma_cmd_result cmd_ap_set_wireless(struct sigma_dut *dut,
 
 			dut->he_ul_mcs = mcs;
 			dut->nss_mcs_set = 1;
+			if (dut->program == PROGRAM_UHR)
+				dut->nss_mcs_cap_mcs = mcs;
 			/* To set mcs_nss_map for HE program */
 			get_he_mcs_nssmap((uint8_t *) &mcsnssmap, nss, mcs);
 			dut->he_mcsnssmap = (mcsnssmap << 16) | mcsnssmap;
@@ -10560,21 +10562,20 @@ static void fwtest_set_he_params(struct sigma_dut *dut, const char *ifname,
 					   ifname,
 					   dut->uhr_2xldpc_rx == VALUE_ENABLED ? 1 : 0);
 
-		/* Testbed default auto-rate MCS cap: when no nss_mcs_opt/
-		 * ForceUHRTXMCS CAPI is sent for a TC, the FW auto-rate
-		 * scheduler is otherwise left uncapped and can select its
-		 * ceiling MCS (e.g. MCS13) instead of the WFA testbed
-		 * default of MCS_TESTBED_VALUE_UHR (9). Cap it here for
-		 * AP_testbed only; a later ap_set_rfeature nss_mcs_opt call
-		 * overwrites this with an explicit cap via the same
-		 * "iw dev <ifname> set bitrates uhr-mcs-<band> ..." command.
-		 * Skip entirely when nss_mcs_cap/NSS_MCS_Cap already set an
-		 * explicit MCS (dut->nss_mcs_set) -- e.g. "4;0-11" or
-		 * "4;0-13" -- so this default does not clobber that cap;
-		 * mirrors the existing !dut->nss_mcs_set guard used for the
-		 * HE/EHT testbed MCS map default elsewhere in this function. */
-		if (dut->device_type == AP_testbed && !dut->nss_mcs_set) {
+		/* Testbed auto-rate MCS cap.  When nss_mcs_cap/NSS_MCS_Cap CAPI
+		 * was sent (e.g. "4;0-11") apply that MCS as the cap -- that
+		 * CAPI only updated the capability IE, it never issued a rate
+		 * command, so the FW auto-rate scheduler was left uncapped and
+		 * could pick its ceiling MCS (observed: MCS13) even though the
+		 * beacon advertised only up to MCS11.  When it was not sent,
+		 * fall back to the WFA testbed default MCS_TESTBED_VALUE_UHR
+		 * (9).  A later ap_set_rfeature nss_mcs_opt call overwrites
+		 * this with its own cap via the same
+		 * "iw dev <ifname> set bitrates uhr-mcs-<band> ..." command. */
+		if (dut->device_type == AP_testbed) {
 			int cap_nss = dut->ap_tx_streams ? dut->ap_tx_streams : 4;
+			int cap_mcs = dut->nss_mcs_cap_mcs >= 0 ?
+				      dut->nss_mcs_cap_mcs : MCS_TESTBED_VALUE_UHR;
 			char mcs_str[128] = "";
 			char tmp[24];
 			int n;
@@ -10582,8 +10583,7 @@ static void fwtest_set_he_params(struct sigma_dut *dut, const char *ifname,
 			for (n = 1; n <= cap_nss; n++) {
 				if (n > 1)
 					strlcat(mcs_str, " ", sizeof(mcs_str));
-				snprintf(tmp, sizeof(tmp), "%d:0-%d", n,
-					 MCS_TESTBED_VALUE_UHR);
+				snprintf(tmp, sizeof(tmp), "%d:0-%d", n, cap_mcs);
 				strlcat(mcs_str, tmp, sizeof(mcs_str));
 			}
 			run_system_wrapper(dut,
@@ -15914,6 +15914,7 @@ static enum sigma_cmd_result cmd_ap_reset_default(struct sigma_dut *dut,
 
 	dut->eht_txmcs = 0;
 	dut->uhr_txmcs = 0;
+	dut->nss_mcs_cap_mcs = -1;
 	dut->uhr_2xldpc = VALUE_DISABLED;
 	dut->imcs_nss = 0;
 	dut->imcs_std_max = -1;
@@ -16066,6 +16067,7 @@ static enum sigma_cmd_result cmd_ap_reset_default(struct sigma_dut *dut,
 	dut->ap_preamblepunct = VALUE_NOT_SET;
 	dut->eht_txmcs = 0;
 	dut->uhr_txmcs = 0;
+	dut->nss_mcs_cap_mcs = -1;
 	dut->uhr_2xldpc = VALUE_DISABLED;
 	dut->uhr_2xldpc_tx = VALUE_NOT_SET;
 	dut->uhr_2xldpc_rx = VALUE_NOT_SET;
@@ -22879,16 +22881,36 @@ static int mac80211_vht_nss_mcs(struct sigma_dut *dut, const char *ifname,
 		} else if (dut->program == PROGRAM_UHR &&
 			   dut->device_type == AP_testbed) {
 			/*
-			 * UHR testbed: for nss_mcs_opt MCS=def, set the NSS
-			 * capability via cfg80211tool instead of clearing the
-			 * fixed rate with "iw set bitrates".  NSS value is the
-			 * explicit NSS field; def;def (not a valid combination)
-			 * falls back to ap_tx_streams, else 4.
+			 * UHR testbed, nss_mcs_opt MCS=def: change NSS only and
+			 * keep the MCS cap requested earlier by nss_mcs_cap
+			 * (e.g. "4;0-11").  Re-issue the same
+			 * "uhr-mcs-<band> <nss>:0-<mcs>" command with the new NSS
+			 * rather than "cfg80211tool nss", which sets NSS alone and
+			 * leaves the FW auto-rate scheduler uncapped.  Falls back
+			 * to MCS_TESTBED_VALUE_UHR (9) when nss_mcs_cap was not
+			 * sent.  NSS: explicit field, else ap_tx_streams, else 4.
 			 */
 			int nss_val = nss ? nss :
 				      (dut->ap_tx_streams ? dut->ap_tx_streams : 4);
+			int cap_mcs = dut->nss_mcs_cap_mcs >= 0 ?
+				      dut->nss_mcs_cap_mcs : MCS_TESTBED_VALUE_UHR;
+			char mcs_str[128] = "";
+			char tmp[24];
+			int n;
 
-			run_iwpriv(dut, ifname, "nss %d", nss_val);
+			for (n = 1; n <= nss_val; n++) {
+				if (n > 1)
+					strlcat(mcs_str, " ", sizeof(mcs_str));
+				snprintf(tmp, sizeof(tmp), "%d:0-%d", n, cap_mcs);
+				strlcat(mcs_str, tmp, sizeof(mcs_str));
+			}
+			sigma_dut_print(dut, DUT_MSG_DEBUG,
+					"nss_mcs_opt def: keep MCS cap %d, set NSS %d "
+					"(iw set bitrates %s uhr-mcs-%s %s)",
+					cap_mcs, nss_val, link_flag, band, mcs_str);
+			run_system_wrapper(dut,
+					   "iw dev %s set bitrates %s uhr-mcs-%s %s",
+					   ifname, link_flag, band, mcs_str);
 		} else if (dut->program == PROGRAM_HE ||
 			   dut->program == PROGRAM_EHT ||
 			   dut->program == PROGRAM_UHR) {
diff --git a/sigma_dut.h b/sigma_dut.h
index 894bbfb..0209522 100644
--- a/sigma_dut.h
+++ b/sigma_dut.h
@@ -1190,6 +1190,12 @@ struct sigma_dut {
 	int ltf_trig;
 	int eht_txmcs;
 	int uhr_txmcs;
+	/* MCS from nss_mcs_cap/NSS_MCS_Cap CAPI (ap_set_wireless), applied
+	 * as the UHR auto-rate cap once wlan0 exists at ap_config_commit.
+	 * -1 = not set. Kept separate from nss_mcs_set (which only guards
+	 * the capability-IE default) so a later nss_mcs_opt,<N>;def can
+	 * still find the MCS this CAPI requested. */
+	int nss_mcs_cap_mcs;
 	int ap_addba_amsdu;
 	unsigned int ap_ehtmcs_map;
 	int run_set_param;
