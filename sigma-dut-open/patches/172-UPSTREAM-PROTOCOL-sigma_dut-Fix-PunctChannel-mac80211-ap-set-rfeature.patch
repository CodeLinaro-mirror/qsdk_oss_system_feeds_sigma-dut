+/* Parse a PunctChannel channel list against a specific link's configured
+ * width and return the resulting bitmap, or -1 if the link's width is not
+ * one that supports puncturing (mirrors get_bitmap_from_punct_chlist()'s
+ * default-case error for an unrecognized width). *chwidth is only valid
+ * when the return value is >= 0. */
+static int mac80211_rfeature_punct_bitmap(struct sigma_dut *dut,
+					  const char *punct_channel_list,
+					  int link_id, int *chwidth)
+{
+	char *punctchannel_val, *saveptr, *punct_channel;
+	unsigned int punct_index = 0;
+	int n, i;
+
+	punct_channel = strdup(punct_channel_list);
+	if (!punct_channel)
+		return -1;
+
+	punctchannel_val = strtok_r(punct_channel, " ", &saveptr);
+
+	if (dut->mld[link_id].ap_chwidth == AP_80) {
+		int punct_80[] = {33, 37, 41, 45};
+
+		*chwidth = 80;
+		while (punctchannel_val != NULL) {
+			n = atoi(punctchannel_val);
+			for (i = 0; i < 4; i++) {
+				if (n == punct_80[i])
+					punct_index |= 1 << i;
+			}
+			punctchannel_val = strtok_r(NULL, " ", &saveptr);
+		}
+	} else if (dut->mld[link_id].ap_chwidth == AP_160) {
+		int punct_160[] = {33, 37, 41, 45, 49, 53, 57, 61};
+
+		*chwidth = 160;
+		while (punctchannel_val != NULL) {
+			n = atoi(punctchannel_val);
+			for (i = 0; i < 8; i++) {
+				if (n == punct_160[i])
+					punct_index |= 1 << i;
+			}
+			punctchannel_val = strtok_r(NULL, " ", &saveptr);
+		}
+	} else if (dut->mld[link_id].ap_chwidth == AP_320) {
+		*chwidth = 320;
+		if (dut->cfreq == 6105) {
+			int punct_320_1[] = {1, 5, 9, 13, 17, 21, 25, 29, 33, 37,
+					     41, 45, 49, 53, 57, 61};
+
+			while (punctchannel_val != NULL) {
+				n = atoi(punctchannel_val);
+				for (i = 0; i < 16; i++) {
+					if (n == punct_320_1[i])
+						punct_index |= 1 << i;
+				}
+				punctchannel_val = strtok_r(NULL, " ", &saveptr);
+			}
+		} else {
+			int punct_320_2[] = {33, 37, 41, 45, 49, 53, 57, 61, 65,
+					     69, 73, 77, 81, 85, 89, 93};
+
+			while (punctchannel_val != NULL) {
+				n = atoi(punctchannel_val);
+				for (i = 0; i < 16; i++) {
+					if (n == punct_320_2[i])
+						punct_index |= 1 << i;
+				}
+				punctchannel_val = strtok_r(NULL, " ", &saveptr);
+			}
+		}
+	} else {
+		free(punct_channel);
+		return -1;
+	}
+
+	free(punct_channel);
+	return (int) punct_index;
+}
+
