From 3eeb9ff2ed126454333dc51333b71bcf6265cfb8 Mon Sep 17 00:00:00 2001
From: Naveen S <quic_naves@quicinc.com>
Date: Fri, 10 Jan 2025 10:33:22 +0530
Subject: [PATCH] QSDK:PROTOCOL: sigma_dut: ap_set_rfeature fix when interface
 is not defined

In ap_set_rfeature command, for mld interfaces the fwtest command are
issued to link 0 by default if the interface is not defined. This is
leading to issues when issuing the command to transmit Trigger frames
in non-HT format as interface wont be defined.

To fix this, issue the fwtest command to change the PPDU type to
non-HT for both links, not just the default link. intf_defined
variable is added to track whether interface is defined.

Signed-off-by: Naveen S <quic_naves@quicinc.com>
---
 ap.c        |  8 +++++++++-
 sigma_dut.h |  1 +
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/ap.c b/ap.c
index e8e2bfe..6440a0a 100644
--- a/ap.c
+++ b/ap.c
@@ -19120,7 +19120,7 @@ static enum sigma_cmd_result mac80211_ap_set_rfeature(struct sigma_dut *dut,
 	unsigned char mac_addr[ETH_ALEN];
 	int he_ackpolicymac = 0;
 	int ap_he_ackpolicy;
-	int link_id = 0;
+	int link_id = dut->intf_defined;
 	int param;
 	char buf[200];
 	int val_bw = -1;
@@ -19142,6 +19142,8 @@ static enum sigma_cmd_result mac80211_ap_set_rfeature(struct sigma_dut *dut,
 			link_id = dut->band_to_link[1];
 		else if (strcasecmp(val, "6G") == 0)
 			link_id = dut->band_to_link[2];
+
+		dut->intf_defined = dut->num_links;
 	}
 
 	val = get_param(cmd, "NonTxBSSIndex");
@@ -19724,6 +19726,9 @@ static enum sigma_cmd_result mac80211_ap_set_rfeature(struct sigma_dut *dut,
 		}
 	}
 
+	if (++dut->intf_defined < dut->num_links)
+		mac80211_ap_set_rfeature(dut, conn, cmd);
+
 	return SUCCESS_SEND_STATUS;
 }
 
@@ -19855,6 +19862,7 @@ static enum sigma_cmd_result cmd_ap_set_rfeature(struct sigma_dut *dut,
 	case DRIVER_WCN:
 		return wcn_ap_set_rfeature(dut, conn, cmd);
 	case DRIVER_MAC80211:
+		dut->intf_defined = 0;
 		return mac80211_ap_set_rfeature(dut, conn, cmd);
 #ifdef __linux__
 	case DRIVER_WIL6210:
diff --git a/sigma_dut.h b/sigma_dut.h
index 9cb86d0..3e4b370 100644
--- a/sigma_dut.h
+++ b/sigma_dut.h
@@ -1398,6 +1398,7 @@ struct sigma_dut {
 	struct mld_ap mld[NUM_OF_LINKS];
 	int link_specific_security;
 	int multi_mld;
+	int intf_defined;
 };
 
 #ifdef NL80211_SUPPORT
-- 
2.34.1

