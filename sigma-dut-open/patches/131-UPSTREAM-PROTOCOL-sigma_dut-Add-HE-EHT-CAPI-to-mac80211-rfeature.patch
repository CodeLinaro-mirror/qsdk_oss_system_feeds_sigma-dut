From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Priyadharshini Gowthaman <pgowtham@qti.qualcomm.com>
Date: Mon, 17 Aug 2026 20:59:30 -0700
Subject: [PATCH] UPSTREAM:PROTOCOL: sigma_dut: Add HE EHT CAPI to mac80211 rfeature

Signed-off-by: Priyadharshini Gowthaman <pgowtham@qti.qualcomm.com>
---
diff --git a/ap.c b/ap.c
index d15a324..ca02b0b 100644
--- a/ap.c
+++ b/ap.c
@@ -22373,6 +22373,89 @@ static int mac80211_set_dscp_policy(struct sigma_dut *dut,
 	return SUCCESS_SEND_STATUS;
 }
 
+static int mac80211_vht_nss_mcs(struct sigma_dut *dut, const char *ifname,
+				const char *val)
+{
+	int nss = 0;
+	int mcs = 0;
+	char *token, *result;
+	char *saveptr;
+	uint16_t mcsnssmap;
+
+	token = strdup(val);
+	if (!token)
+		return -1;
+	result = strtok_r(token, ";", &saveptr);
+	if (!result) {
+		sigma_dut_print(dut, DUT_MSG_ERROR, "VHT NSS not specified");
+		goto end;
+	}
+	if (strcasecmp(result, "def") != 0) {
+		nss = atoi(result);
+		if (nss == 4)
+			ath_disable_txbf(dut, ifname);
+		run_iwpriv(dut, ifname, "nss %d", nss);
+	} else {
+		if (dut->device_type == AP_testbed && dut->ap_sgi80 == 1)
+			run_iwpriv(dut, ifname, "nss 1");
+		if (dut->device_type == AP_testbed && dut->program == PROGRAM_HE) {
+			nss = dut->ap_tx_streams;
+			run_iwpriv(dut, ifname, "nss %d", nss);
+		}
+	}
+
+	result = strtok_r(NULL, ";", &saveptr);
+	if (!result) {
+		sigma_dut_print(dut, DUT_MSG_ERROR, "VHT MCS not specified");
+		goto end;
+	}
+	if (strcasecmp(result, "def") == 0) {
+		if (dut->device_type == AP_testbed && dut->ap_sgi80 == 1)
+			run_iwpriv(dut, ifname, "vhtmcs 7");
+		else if (dut->program == PROGRAM_HE)
+			run_iwpriv(dut, ifname, "set11NRates 0");
+		if (dut->device_type == AP_testbed && dut->program == PROGRAM_HE) {
+			novap_reset(dut, ifname, 0);
+			get_he_mcs_nssmap((uint8_t *) &mcsnssmap, nss,
+					  MCS_TESTBED_VALUE);
+			dut->he_mcsnssmap = (mcsnssmap << 16) | mcsnssmap;
+			run_iwpriv(dut, ifname, "he_rxmcsmap %u", dut->he_mcsnssmap);
+			run_iwpriv(dut, ifname, "he_txmcsmap %u", dut->he_mcsnssmap);
+			novap_reset(dut, ifname, 1);
+		}
+	} else {
+		mcs = atoi(result);
+		if (dut->program == PROGRAM_HE) {
+			dut->ap_fixed_rate = 1;
+			run_iwpriv(dut, ifname, "he_mcs %d", mcs);
+		} else if (dut->ap_mode == AP_11be) {
+			dut->ap_fixed_rate = 1;
+			run_iwpriv(dut, ifname, "eht_mcs %d", mcs);
+		} else {
+			run_iwpriv(dut, ifname, "vhtmcs %d", mcs);
+		}
+	}
+
+end:
+	free(token);
+	return 0;
+}
+
+
+static void mac80211_set_trigger_type_testdisable(struct sigma_dut *dut,
+						  const char *ifname)
+{
+	fwtest_cmd_wrapper(dut, "-m 0x47 -v 0 92 0", ifname);
+}
+
+
+static void mac80211_set_trigger_type_testenable(struct sigma_dut *dut,
+						 const char *ifname)
+{
+	fwtest_cmd_wrapper(dut, "-m 0x47 -v 0 92 1", ifname);
+}
+
+
 static enum sigma_cmd_result mac80211_ap_set_rfeature(struct sigma_dut *dut,
 						      struct sigma_conn *conn,
 						      struct sigma_cmd *cmd)
@@ -23208,6 +23291,253 @@ static enum sigma_cmd_result mac80211_ap_set_rfeature(struct sigma_dut *dut,
 	if (dut->ap_dl_availcap >= 0 || dut->ap_ul_availcap >= 0)
 		run_hostapd_cli(dut, "UPDATE_BEACON");
 
+	val = get_param(cmd, "nss_mcs_opt");
+	if (val && mac80211_vht_nss_mcs(dut, ifname, val) < 0)
+		return ERROR_SEND_STATUS;
+
+	val = get_param(cmd, "Trig_Usrinfo_UL-MCS");
+	if (val) {
+		int mcs = atoi(val);
+
+		dut->ap_fixed_rate = 1;
+		if (dut->program == PROGRAM_EHT)
+			run_iwpriv(dut, ifname, "eht_ul_mcs %d", mcs);
+		else
+			run_iwpriv(dut, ifname, "he_ul_mcs %d", mcs);
+	}
+
+	val = get_param(cmd, "TriggerCoding");
+	if (val) {
+		if (strcasecmp(val, "BCC") == 0) {
+			if (dut->program == PROGRAM_EHT)
+				run_iwpriv(dut, ifname, "eht_ul_ldpc 0");
+			else
+				run_iwpriv(dut, ifname, "he_ul_ldpc 0");
+		} else if (strcasecmp(val, "LDPC") == 0) {
+			novap_reset(dut, ifname, 0);
+			if (dut->program == PROGRAM_EHT)
+				run_iwpriv(dut, ifname, "eht_ul_ldpc 1");
+			else
+				run_iwpriv(dut, ifname, "he_ul_ldpc 1");
+			novap_reset(dut, ifname, 1);
+		} else {
+			send_resp(dut, conn, SIGMA_ERROR,
+				  "errorCode,Unsupported TriggerCoding");
+			return STATUS_SENT_ERROR;
+		}
+	}
+
+	val = get_param(cmd, "DisableTriggerType");
+	if (val) {
+		int trigtype = atoi(val);
+
+		switch (trigtype) {
+		case 0:
+			/* Basic trigger */
+			fwtest_cmd_wrapper(dut, "-m 0x47 -v 0 42 0", ifname);
+			break;
+		case 3:
+			/* MURTS trigger */
+			fwtest_cmd_wrapper(dut, "-m 0x47 -v 0 101 0", ifname);
+			break;
+		default:
+			break;
+		}
+	}
+
+	val = get_param(cmd, "Trig_Interval");
+	if (val) {
+		const char *basedev = sigma_radio_ifname[0] ? sigma_radio_ifname[0] : "wifi0";
+
+		run_iwpriv(dut, basedev, "he_ul_trig_int %d", atoi(val));
+	}
+
+	val = get_param(cmd, "Trig_ComInfo_ULLength");
+	if (val) {
+		if (dut->ap_mbssid != VALUE_ENABLED && dut->ap_interface_6g)
+			fwtest_cmd_wrapper(dut, "-m 0x48 -v 0 141", ifname);
+	}
+
+	val = get_param(cmd, "NAV_Update");
+	if (val) {
+		if (strcasecmp(val, "disable") == 0) {
+			const char *basedev = sigma_radio_ifname[0] ? sigma_radio_ifname[0] : "wifi0";
+
+			run_iwpriv(dut, basedev, "nav_config 1 0");
+		}
+	}
+
+	val = get_param(cmd, "ForceEHTTXNSS");
+	if (val)
+		run_iwpriv(dut, ifname, "nss %d", atoi(val));
+
+	val = get_param(cmd, "ExtraLTFSymbols");
+	if (val)
+		run_iwpriv(dut, ifname, "eht_max_supp_ltf %d", atoi(val));
+
+	/* EHTSoundingNDP_LTF must come before EHTSoundingNDP_GI */
+	{
+		int soundingndp_ltf = -1;
+
+		val = get_param(cmd, "EHTSoundingNDP_LTF");
+		if (val) {
+			if (strcmp(val, "3.2") == 0)
+				soundingndp_ltf = 0;
+			else if (strcmp(val, "6.4") == 0)
+				soundingndp_ltf = 1;
+			else if (strcmp(val, "12.8") == 0)
+				soundingndp_ltf = 2;
+		}
+
+		val = get_param(cmd, "EHTSoundingNDP_GI");
+		if (val) {
+			int soundingndp_gi;
+
+			if (strcmp(val, "0.4") == 0)
+				soundingndp_gi = 1;
+			else if (strcmp(val, "0.8") == 0)
+				soundingndp_gi = 0;
+			else if (strcmp(val, "1.6") == 0)
+				soundingndp_gi = 2;
+			else if (strcmp(val, "3.2") == 0)
+				soundingndp_gi = 3;
+			else
+				soundingndp_gi = 0;
+			/* Disable partial sounding before setting NDP params */
+			fwtest_cmd_wrapper(dut, "-m 0x47 -v 0 112 0", ifname);
+			run_system_wrapper(dut,
+					   "ath11k-fwtest -i %s -m 0x48 -v 0 620 %d %d",
+					   ifname, soundingndp_ltf, soundingndp_gi);
+		}
+	}
+
+	val = get_param(cmd, "EMLInitialControlFrame");
+	if (val) {
+		if (strcasecmp(val, "MURTS") == 0) {
+			fwtest_cmd_wrapper(dut, "-m 0x47 -v 0 545 1", ifname);
+		} else if (strcasecmp(val, "BSRP") == 0) {
+			fwtest_cmd_wrapper(dut, "-m 0x47 -v 0 545 0", ifname);
+		} else {
+			send_resp(dut, conn, SIGMA_ERROR,
+				  "errorCode,Unsupported EMLInitialControlFrame");
+			return STATUS_SENT_ERROR;
+		}
+	}
+
+	val = get_param(cmd, "LinkReconfigResp_Add");
+	if (val) {
+		int link = atoi(val);
+
+		run_system_wrapper(dut, "cfg80211tool mld0:%d mlrecfg_add_link_rej 0",
+				   link);
+		/* Reject on all other links */
+		for (i = 0; i < 3; i++) {
+			if (i != link)
+				run_system_wrapper(dut,
+						   "cfg80211tool mld0:%d mlrecfg_add_link_rej 1",
+						   i);
+		}
+	}
+
+	val = get_param(cmd, "LinkReconfigResp_Delete");
+	if (val) {
+		int link = atoi(val);
+
+		run_system_wrapper(dut, "cfg80211tool mld0:%d mlrecfg_del_link_rej 1",
+				   link);
+	}
+
+	val = get_param(cmd, "TeardownAllTWT");
+	if (val) {
+		const char *str_val = get_param(cmd, "RxMac");
+
+		if (str_val)
+			run_system_wrapper(dut,
+					   "wifitool %s ap_twt_del_dialog %s 255 0",
+					   ifname, str_val);
+	}
+
+	val = get_param(cmd, "TWTElement");
+	if (val) {
+		if (strcasecmp(val, "Exclude") == 0) {
+			run_system_wrapper(dut,
+					   "wifitool %s ap_twt_del_dialog 00:00:00:00:00:00 255 0",
+					   ifname);
+		} else {
+			send_resp(dut, conn, SIGMA_ERROR,
+				  "errorCode,Unsupported TWTElement");
+			return STATUS_SENT_ERROR;
+		}
+	}
+
+	val = get_param(cmd, "TriggerTx");
+	if (val) {
+		int triggertx = atoi(val);
+
+		switch (triggertx) {
+		case 0:
+			mac80211_set_trigger_type_testdisable(dut, ifname);
+			break;
+		case 1:
+			mac80211_set_trigger_type_testenable(dut, ifname);
+			break;
+		default:
+			send_resp(dut, conn, SIGMA_ERROR,
+				  "errorCode,TriggerTx not supported");
+			return STATUS_SENT_ERROR;
+		}
+	}
+
+	/* STA_MUEDCA per-AC parameters */
+	val = get_param(cmd, "STA_MUEDCA_ECWmin_BE");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_ecwmin %d %d", AP_AC_BE, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_ECWmin_BK");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_ecwmin %d %d", AP_AC_BK, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_ECWmin_VI");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_ecwmin %d %d", AP_AC_VI, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_ECWmin_VO");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_ecwmin %d %d", AP_AC_VO, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_ECWmax_BE");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_ecwmax %d %d", AP_AC_BE, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_ECWmax_BK");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_ecwmax %d %d", AP_AC_BK, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_ECWmax_VI");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_ecwmax %d %d", AP_AC_VI, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_ECWmax_VO");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_ecwmax %d %d", AP_AC_VO, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_AIFSN_BE");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_aifsn %d %d", AP_AC_BE, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_AIFSN_BK");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_aifsn %d %d", AP_AC_BK, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_AIFSN_VI");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_aifsn %d %d", AP_AC_VI, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_AIFSN_VO");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_aifsn %d %d", AP_AC_VO, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_Timer_BE");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_timer %d %d", AP_AC_BE, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_Timer_BK");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_timer %d %d", AP_AC_BK, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_Timer_VI");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_timer %d %d", AP_AC_VI, atoi(val));
+	val = get_param(cmd, "STA_MUEDCA_Timer_VO");
+	if (val)
+		run_iwpriv(dut, ifname, "muedca_timer %d %d", AP_AC_VO, atoi(val));
+
 	return SUCCESS_SEND_STATUS;
 }
 
