From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Priyadharshini Gowthaman <pgowtham@qti.qualcomm.com>
Date: Mon, 17 Aug 2026 21:00:42 -0700
Subject: [PATCH] UPSTREAM:PROTOCOL: sigma_dut: Use iw set bitrates for nss mcs opt

Signed-off-by: Priyadharshini Gowthaman <pgowtham@qti.qualcomm.com>
---
diff --git a/ap.c b/ap.c
index d1ff4eb..3a31c74 100644
--- a/ap.c
+++ b/ap.c
@@ -22392,17 +22392,67 @@ static int mac80211_set_dscp_policy(struct sigma_dut *dut,
 }
 
 static int mac80211_vht_nss_mcs(struct sigma_dut *dut, const char *ifname,
-				const char *val)
+				const char *val, int link_id)
 {
+	/*
+	 * Parse the nss_mcs_opt CAPI value ("NSS;MCS" or "def;def").
+	 *
+	 * Rate setting strategy
+	 * ---------------------
+	 * Fixed rate (MCS != def):
+	 *   Use "iw <ifname> set bitrates [-l link_id] <preamble>-mcs-<band>
+	 *   <nss>:<mcs>" — the standard nl80211 path.  NSS is embedded in the
+	 *   <NSS>:<MCS> token so no separate iwpriv nss command is needed.
+	 *   The -l link_id flag enables per-MLO-link rate control for EHT.
+	 *
+	 * Auto rate (MCS == def):
+	 *   Use "iw <ifname> set bitrates [-l link_id]" with no preamble arg
+	 *   to clear any fixed-rate constraint and return to auto rate.
+	 *   Replaces "iwpriv set11NRates 0".
+	 *
+	 * Testbed MCS map (he_rxmcsmap / he_txmcsmap):
+	 *   These update the capability IE advertised in beacons — they are
+	 *   NOT runtime TX rate commands.  They stay as iwpriv and are wrapped
+	 *   by novap_reset to trigger hostapd beacon reconverge.  This block
+	 *   is completely independent of the rate commands above.
+	 *
+	 * Band string follows mac80211_he_gi() convention:
+	 *   6 GHz -> "6",  5 GHz -> "5",  2.4 GHz -> "2.4"
+	 */
 	int nss = 0;
 	int mcs = 0;
 	char *token, *result;
 	char *saveptr;
 	uint16_t mcsnssmap;
+	const char *band;
+	char link_flag[16] = ""; /* "-l <n>" for EHT MLO, empty for non-MLO */
+
+	/*
+	 * Determine band string.  Mirror mac80211_he_gi() exactly so the
+	 * "iw set bitrates" command targets the right frequency band.
+	 */
+	if (dut->ap_is_dual && dut->mld[link_id].ap_mode == AP_11be) {
+		if (link_id == dut->band_to_link[0])
+			band = "2.4";
+		else if (link_id == dut->band_to_link[1])
+			band = "5";
+		else if (link_id == dut->band_to_link[2])
+			band = "6";
+		else if (link_id == dut->band_to_link[3])
+			band = "5";
+		else
+			band = "5";
+		snprintf(link_flag, sizeof(link_flag), "-l %d", link_id);
+	} else {
+		band = dut->ap_band_6g ? "6" : dut->use_5g ? "5" : "2.4";
+		/* link_flag stays empty for non-MLO */
+	}
 
 	token = strdup(val);
 	if (!token)
 		return -1;
+
+	/* --- NSS field --- */
 	result = strtok_r(token, ";", &saveptr);
 	if (!result) {
 		sigma_dut_print(dut, DUT_MSG_ERROR, "VHT NSS not specified");
@@ -22410,47 +22460,148 @@ static int mac80211_vht_nss_mcs(struct sigma_dut *dut, const char *ifname,
 	}
 	if (strcasecmp(result, "def") != 0) {
 		nss = atoi(result);
+		/*
+		 * NSS=4 implies TxBF disable (4-stream BF not supported).
+		 * This is a capability toggle, not a rate change — keep iwpriv.
+		 */
 		if (nss == 4)
 			ath_disable_txbf(dut, ifname);
-		run_iwpriv(dut, ifname, "nss %d", nss);
+		/*
+		 * NSS value is carried inside the "<nss>:<mcs>" token in the
+		 * "iw set bitrates" call below.  No separate "iwpriv nss" needed.
+		 */
 	} else {
+		/*
+		 * def NSS: testbed-mode capability resets (iwpriv — these set
+		 * the beacon IE NSS count, not the runtime TX rate).
+		 */
 		if (dut->device_type == AP_testbed && dut->ap_sgi80 == 1)
 			run_iwpriv(dut, ifname, "nss 1");
-		if (dut->device_type == AP_testbed && dut->program == PROGRAM_HE) {
-			nss = dut->ap_tx_streams;
-			run_iwpriv(dut, ifname, "nss %d", nss);
-		}
+		if (dut->device_type == AP_testbed && dut->program == PROGRAM_HE)
+			nss = dut->ap_tx_streams; /* used in mcsmap block below */
 	}
 
+	/* --- MCS field --- */
 	result = strtok_r(NULL, ";", &saveptr);
 	if (!result) {
 		sigma_dut_print(dut, DUT_MSG_ERROR, "VHT MCS not specified");
 		goto end;
 	}
+
 	if (strcasecmp(result, "def") == 0) {
-		if (dut->device_type == AP_testbed && dut->ap_sgi80 == 1)
+		/*
+		 * Auto rate path.
+		 *
+		 * "iw set bitrates" with no preamble/MCS arguments clears any
+		 * previously fixed rate and returns the scheduler to auto rate
+		 * selection.  This replaces "iwpriv set11NRates 0".
+		 *
+		 * The testbed he_rxmcsmap/he_txmcsmap block below is a separate
+		 * beacon capability update — it is unaffected by this change.
+		 */
+		if (dut->device_type == AP_testbed && dut->ap_sgi80 == 1) {
+			/* SGI testbed WAR: keep fixed at VHT MCS7 */
 			run_iwpriv(dut, ifname, "vhtmcs 7");
-		else if (dut->program == PROGRAM_HE)
-			run_iwpriv(dut, ifname, "set11NRates 0");
+		} else if (dut->program == PROGRAM_HE ||
+			   dut->program == PROGRAM_EHT) {
+			sigma_dut_print(dut, DUT_MSG_DEBUG,
+					"nss_mcs_opt def: reset to auto rate "
+					"(iw %s set bitrates %s)",
+					ifname, link_flag);
+			run_system_wrapper(dut, "iw %s set bitrates %s",
+					   ifname, link_flag);
+		}
+
+		/*
+		 * Testbed MCS capability IE reset — stays as iwpriv.
+		 * novap_reset brackets the change so hostapd reconverges
+		 * the beacon with the new he_rxmcsmap/he_txmcsmap values.
+		 * This block is INDEPENDENT of the rate commands above.
+		 */
 		if (dut->device_type == AP_testbed && dut->program == PROGRAM_HE) {
+			if (nss > 0)
+				run_iwpriv(dut, ifname, "nss %d", nss);
 			novap_reset(dut, ifname, 0);
 			get_he_mcs_nssmap((uint8_t *) &mcsnssmap, nss,
 					  MCS_TESTBED_VALUE);
 			dut->he_mcsnssmap = (mcsnssmap << 16) | mcsnssmap;
+			/* iwpriv: updates beacon capability IE, NOT TX rate */
 			run_iwpriv(dut, ifname, "he_rxmcsmap %u", dut->he_mcsnssmap);
 			run_iwpriv(dut, ifname, "he_txmcsmap %u", dut->he_mcsnssmap);
 			novap_reset(dut, ifname, 1);
 		}
 	} else {
+		/*
+		 * Fixed rate path.
+		 *
+		 * Use "iw set bitrates" standard nl80211 interface:
+		 *   iw <ifname> set bitrates [link_flag]
+		 *       legacy-<band>
+		 *       ht-mcs-<band>
+		 *       vht-mcs-<band>
+		 *       he-mcs-<band>   [<nss>:<mcs> for HE]
+		 *       eht-mcs-<band>  [<nss>:<mcs> for EHT]
+		 *       uhr-mcs-<band>
+		 *
+		 * Leaving a preamble with no MCS argument clears any fixed
+		 * rate for that preamble (driver reverts it to auto).
+		 * Only the target preamble gets the <nss>:<mcs> spec.
+		 *
+		 * Replaces:
+		 *   "iwpriv nss N" + "iwpriv he_mcs M"   for HE
+		 *   "iwpriv nss N" + "iwpriv eht_mcs M"  for EHT
+		 *   "iwpriv nss N" + "iwpriv vhtmcs M"   for VHT/legacy
+		 */
 		mcs = atoi(result);
+		dut->ap_fixed_rate = 1;
+		if (nss == 0)
+			nss = 1; /* default NSS=1 when not specified */
+
 		if (dut->program == PROGRAM_HE) {
-			dut->ap_fixed_rate = 1;
-			run_iwpriv(dut, ifname, "he_mcs %d", mcs);
+			sigma_dut_print(dut, DUT_MSG_DEBUG,
+					"nss_mcs_opt HE fixed rate: "
+					"iw set bitrates %s he-mcs-%s %d:%d",
+					link_flag, band, nss, mcs);
+			run_system_wrapper(dut,
+					   "iw %s set bitrates %s "
+					   "legacy-%s ht-mcs-%s vht-mcs-%s "
+					   "he-mcs-%s %d:%d "
+					   "eht-mcs-%s uhr-mcs-%s",
+					   ifname, link_flag,
+					   band, band, band,
+					   band, nss, mcs,
+					   band, band);
 		} else if (dut->ap_mode == AP_11be) {
-			dut->ap_fixed_rate = 1;
-			run_iwpriv(dut, ifname, "eht_mcs %d", mcs);
+			sigma_dut_print(dut, DUT_MSG_DEBUG,
+					"nss_mcs_opt EHT fixed rate: "
+					"iw set bitrates %s eht-mcs-%s %d:%d",
+					link_flag, band, nss, mcs);
+			run_system_wrapper(dut,
+					   "iw %s set bitrates %s "
+					   "legacy-%s ht-mcs-%s vht-mcs-%s "
+					   "he-mcs-%s "
+					   "eht-mcs-%s %d:%d "
+					   "uhr-mcs-%s",
+					   ifname, link_flag,
+					   band, band, band,
+					   band,
+					   band, nss, mcs,
+					   band);
 		} else {
-			run_iwpriv(dut, ifname, "vhtmcs %d", mcs);
+			/* VHT or legacy */
+			sigma_dut_print(dut, DUT_MSG_DEBUG,
+					"nss_mcs_opt VHT fixed rate: "
+					"iw set bitrates %s vht-mcs-%s %d:%d",
+					link_flag, band, nss, mcs);
+			run_system_wrapper(dut,
+					   "iw %s set bitrates %s "
+					   "legacy-%s ht-mcs-%s "
+					   "vht-mcs-%s %d:%d "
+					   "he-mcs-%s eht-mcs-%s uhr-mcs-%s",
+					   ifname, link_flag,
+					   band, band,
+					   band, nss, mcs,
+					   band, band, band);
 		}
 	}
 
@@ -23473,7 +23624,7 @@ static enum sigma_cmd_result mac80211_ap_set_rfeature(struct sigma_dut *dut,
 	(void) transmitomi_eht; /* suppress unused warning until OMCtrl is ported */
 
 	val = get_param(cmd, "nss_mcs_opt");
-	if (val && mac80211_vht_nss_mcs(dut, ifname, val) < 0)
+	if (val && mac80211_vht_nss_mcs(dut, ifname, val, link_id) < 0)
 		return ERROR_SEND_STATUS;
 
 	val = get_param(cmd, "Trig_Usrinfo_UL-MCS");
