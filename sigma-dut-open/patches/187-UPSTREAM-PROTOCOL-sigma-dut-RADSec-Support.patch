From 262b6c805719cda00a7121af102537d470996798 Mon Sep 17 00:00:00 2001
From: Priyadharshini Gowthaman <pgowtham@qti.qualcomm.com>
Date: Mon, 12 Oct 2026 11:27:35 +0530
Subject: [PATCH] UPSTREAM:PROTOCOL:sigma-dut - RADSec Support

Add Sigma support to configure the AP with below:

auth_server_addr=IP Address or server hostname
auth_server_port=2083
auth_server_type=TLS
auth_server_shared_secret=radsec
auth_server_ca_cert=<path to trusted CA certificate(s)>
auth_server_client_cert=<path to client certificate>
auth_server_private_key=<path to private key>
auth_server_private_key_passwd=<password for decrypting private key>

Patch-dependency: None

Signed-off-by: Sai Pratyusha Magam <smagam@qti.qualcomm.com>
Signed-off-by: Priyadharshini Gowthaman <pgowtham@qti.qualcomm.com>
---
 ap.c        | 208 +++++++++++++++++++++++++++++++++++++++++++++-------
 sigma_dut.h |   4 +
 2 files changed, 187 insertions(+), 25 deletions(-)

diff --git a/ap.c b/ap.c
index 9a9d6d3..67897cc 100644
--- a/ap.c
+++ b/ap.c
@@ -24,6 +24,7 @@
 #include <net/if_dl.h>
 #endif /* __QNXNTO__ */
 #include <net/if.h>
+#include <netdb.h>
 #include "wpa_ctrl.h"
 #include "wpa_helpers.h"
 #include "nl80211_copy.h"
@@ -4880,6 +4881,60 @@ static enum sigma_cmd_result cmd_ap_set_radius(struct sigma_dut *dut,
 			 "%s", val);
 	}
 
+	/* ServerReference is the RADIUS server hostname or IP. Resolve to
+	 * IPv4 for auth_server_addr (hostapd requires IP). Store the original
+	 * value in ap_radius_server_ref for auth_server_hostname only when it
+	 * is a hostname — if it is already an IP, skip CN/SAN check since
+	 * there is no hostname to verify against (TC 24.3 scenario). */
+	val = get_param(cmd, "ServerReference");
+	if (val) {
+		struct addrinfo hints, *res = NULL;
+		char resolved[INET_ADDRSTRLEN];
+		struct in_addr addr_check;
+
+		if (strlen(val) > sizeof(dut->ap_radius_server_ref) - 1)
+			return -1;
+
+		/* Only store as hostname (for CN/SAN check) when it is not
+		 * a plain IP address */
+		if (!inet_aton(val, &addr_check)) {
+			snprintf(dut->ap_radius_server_ref,
+				 sizeof(dut->ap_radius_server_ref), "%s", val);
+		} else {
+			dut->ap_radius_server_ref[0] = '\0';
+		}
+
+		memset(&hints, 0, sizeof(hints));
+		hints.ai_family = AF_INET;
+		hints.ai_socktype = SOCK_DGRAM;
+		if (getaddrinfo(val, NULL, &hints, &res) == 0 && res) {
+			struct sockaddr_in *sin =
+				(struct sockaddr_in *) res->ai_addr;
+			inet_ntop(AF_INET, &sin->sin_addr,
+				  resolved, sizeof(resolved));
+			snprintf(radius_ipaddr,
+				 sizeof(dut->ap_radius_ipaddr),
+				 "%s", resolved);
+			freeaddrinfo(res);
+			sigma_dut_print(dut, DUT_MSG_DEBUG,
+					"ServerReference %s resolved to %s",
+					val, resolved);
+		} else if (dut->ap_preset_dns[0]) {
+			snprintf(radius_ipaddr,
+				 sizeof(dut->ap_radius_ipaddr),
+				 "%s", dut->ap_preset_dns);
+			sigma_dut_print(dut, DUT_MSG_INFO,
+					"ServerReference %s unresolvable, "
+					"using Primary-DNS %s",
+					val, dut->ap_preset_dns);
+		} else {
+			sigma_dut_print(dut, DUT_MSG_ERROR,
+					"Failed to resolve ServerReference %s",
+					val);
+			return -1;
+		}
+	}
+
 	val = get_param(cmd, "PASSWORD");
 	if (val) {
 		if (strlen(val) > sizeof(dut->ap_radius_password) - 1)
@@ -4888,6 +4943,22 @@ static enum sigma_cmd_result cmd_ap_set_radius(struct sigma_dut *dut,
 			 sizeof(dut->ap_radius_password), "%s", val);
 	}
 
+	val = get_param(cmd, "TrustAnchor");
+	if (val) {
+		if (strlen(val) > sizeof(dut->ap_radius_ca_cert) - 1)
+			return -1;
+		snprintf(dut->ap_radius_ca_cert, sizeof(dut->ap_radius_ca_cert),
+			 "%s", val);
+	}
+
+	val = get_param(cmd, "ClientCertificate");
+	if (val) {
+		if (strlen(val) > sizeof(dut->ap_radius_client_cert) - 1)
+			return -1;
+		snprintf(dut->ap_radius_client_cert,
+			 sizeof(dut->ap_radius_client_cert), "%s", val);
+	}
+
 	return 1;
 }
 
@@ -10770,6 +10841,54 @@ nla_put_failure:
 }
 
 
+/* Write RadSec (RADIUS-over-TLS) hostapd.conf parameters when a TrustAnchor
+ * and ClientCertificate were provided via ap_set_radius.
+ * auth_server_hostname carries the original ServerReference hostname so
+ * hostapd can resolve it at connect time and verify the server cert CN/SAN.
+ * auth_server_addr carries the hostname too — hostapd (CONFIG_RADIUS_TLS)
+ * performs DNS resolution itself.
+ * Bare cert filenames (no leading '/') are prefixed with SIGMA_TMPDIR since
+ * hostapd's working directory is '/' not '/tmp'.
+ * The shared secret is overridden with "radsec" per RFC 6614. */
+static void ap_write_radsec_conf(FILE *f, struct sigma_dut *dut)
+{
+	const char *ca = dut->ap_radius_ca_cert;
+	const char *cl = dut->ap_radius_client_cert;
+	const char *hn = dut->ap_radius_server_ref;
+
+	if (!ca[0])
+		return;
+	/* auth_server_addr can be both an IP Address or server hostname
+	 * If hostname is available, set auth_server_addr with server hostname,
+	 * else configure it with IP Address
+	 */
+	if (hn[0])
+		fprintf(f, "auth_server_addr=%s\n", hn);
+	else
+		fprintf(f, "auth_server_addr=%s\n", dut->ap_radius_ipaddr);
+	
+	fprintf(f, "auth_server_port=%d\n", dut->ap_radius_port);
+	fprintf(f, "auth_server_type=TLS\n");
+	if (ca[0] == '/')
+		fprintf(f, "auth_server_ca_cert=%s\n", ca);
+	else
+		fprintf(f, "auth_server_ca_cert=%s/%s\n", SIGMA_TMPDIR, ca);
+	if (cl[0]) {
+		if (cl[0] == '/') {
+			fprintf(f, "auth_server_client_cert=%s\n", cl);
+			fprintf(f, "auth_server_private_key=%s\n", cl);
+		} else {
+			fprintf(f, "auth_server_client_cert=%s/%s\n",
+				SIGMA_TMPDIR, cl);
+			fprintf(f, "auth_server_private_key=%s/%s\n",
+				SIGMA_TMPDIR, cl);
+		}
+	}
+	/* RFC 6614: RadSec shared secret must be the literal string "radsec" */
+	fprintf(f, "auth_server_shared_secret=radsec\n");
+}
+
+
 static int set_second_ap_security_conf(FILE *file, struct sigma_dut *dut, int link_id)
 {
 	const char *key_mgmt;
@@ -10844,6 +10963,7 @@ static int set_second_ap_security_conf(FILE *file, struct sigma_dut *dut, int li
 				dut->ap2_radius_port);
 			fprintf(file, "auth_server_shared_secret=%s\n",
 				dut->ap2_radius_password);
+			ap_write_radsec_conf(file, dut);
 		} else if (dut->ap_radius_port) {
 			fprintf(file, "auth_server_addr=%s\n",
 				dut->ap_radius_ipaddr);
@@ -10851,6 +10971,7 @@ static int set_second_ap_security_conf(FILE *file, struct sigma_dut *dut, int li
 				dut->ap_radius_port);
 			fprintf(file, "auth_server_shared_secret=%s\n",
 				dut->ap_radius_password);
+			ap_write_radsec_conf(file, dut);
 		} else
 			sigma_dut_print(dut, DUT_MSG_INFO,
 					"No RADIUS config for AP2");
@@ -10884,13 +11005,16 @@ static int set_second_ap_security_conf(FILE *file, struct sigma_dut *dut, int li
 			fprintf(file, "ieee80211w=1\n");
 		}
 		fprintf(file, "wpa=2\n");
-		fprintf(file, "auth_server_addr=%s\n", dut->ap_radius_ipaddr);
-		if (dut->ap_radius_port) {
-			fprintf(file, "auth_server_port=%d\n",
-				dut->ap_radius_port);
+		if (!dut->ap_radius_ca_cert[0]) {
+			fprintf(file, "auth_server_addr=%s\n", dut->ap_radius_ipaddr);
+			if (dut->ap_radius_port) {
