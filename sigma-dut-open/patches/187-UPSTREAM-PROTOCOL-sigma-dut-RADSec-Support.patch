 			}
 			if (akm_values & (1 << AKM_EPPKE)) {
 				if (dut->ap_sae_passwords) {
@@ -12034,12 +12161,15 @@ enum sigma_cmd_result cmd_ap_config_commit(struct sigma_dut *dut,
 			if (group_cipher != AP_NO_GROUP_CIPHER_SET)
