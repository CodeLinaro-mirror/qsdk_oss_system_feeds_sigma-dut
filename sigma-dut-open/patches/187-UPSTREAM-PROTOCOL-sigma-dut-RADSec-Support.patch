 	if (is_passpoint(dut->program) ||
@@ -22954,6 +23092,26 @@ cmd_ap_preset_testparameters(struct sigma_dut *dut, struct sigma_conn *conn,
 		dut->mld[link_id].ap_channel = atoi(val);
 	}
 
+	val = get_param(cmd, "Primary-DNS");
+	if (!val)
+		val = get_param(cmd, "Primay-DNS"); /* handle WFA typo */
+	if (val) {
