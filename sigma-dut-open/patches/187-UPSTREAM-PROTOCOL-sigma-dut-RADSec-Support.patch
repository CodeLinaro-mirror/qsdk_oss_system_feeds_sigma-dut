 		case AP_WPA2_OWE:
 			fprintf(f, "wpa=2\n");
@@ -14898,6 +15031,11 @@ static enum sigma_cmd_result cmd_ap_reset_default(struct sigma_dut *dut,
 	free(dut->ap_sae_pk_keypair_sig);
 	dut->ap_sae_pk_keypair_sig = NULL;
 
+	dut->ap_radius_ca_cert[0] = '\0';
