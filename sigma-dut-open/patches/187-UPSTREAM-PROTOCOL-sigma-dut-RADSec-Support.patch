+					dut->ap_radius_port);
+			}
+			fprintf(file, "auth_server_shared_secret=%s\n",
+				dut->ap_radius_password);
 		}
-		fprintf(file, "auth_server_shared_secret=%s\n",
-			dut->ap_radius_password);
+		ap_write_radsec_conf(file, dut);
 		fprintf(file, "wpa_pairwise=%s\n",
 			hostapd_cipher_name(dut->ap_cipher));
 		fprintf(file, "sae_pwe=1\n");
@@ -11832,13 +11956,16 @@ enum sigma_cmd_result cmd_ap_config_commit(struct sigma_dut *dut,
 						  (1 << AKM_FT_FILS_SHA256) |
 						  (1 << AKM_FT_FILS_SHA384))) {
 				fprintf(f, "ieee8021x=1\n");
-				fprintf(f, "auth_server_addr=%s\n",
