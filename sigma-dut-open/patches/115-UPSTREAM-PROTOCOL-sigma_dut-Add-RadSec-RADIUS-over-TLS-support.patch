+/* Write RadSec (RADIUS-over-TLS) hostapd.conf parameters when a TrustAnchor
+ * and ClientCertificate were provided via ap_set_radius.
+ * auth_server_hostname carries the original ServerReference hostname so
+ * hostapd can resolve it at connect time and verify the server cert CN/SAN.
+ * auth_server_addr carries the hostname too — hostapd (CONFIG_RADIUS_TLS)
+ * performs DNS resolution itself.
+ * Bare cert filenames (no leading '/') are prefixed with SIGMA_TMPDIR since
+ * hostapd's working directory is '/' not '/tmp'.
+ * The shared secret is overridden with "radsec" per RFC 6614. */
+static void ap_write_radsec_conf(FILE *f, struct sigma_dut *dut)
+{
+	const char *ca = dut->ap_radius_ca_cert;
+	const char *cl = dut->ap_radius_client_cert;
+	const char *hn = dut->ap_radius_server_ref;
+
+	if (!ca[0])
+		return;
+	/* auth_server_addr must be an IP — hostapd_parse_ip_addr() rejects
+	 * hostnames at config parse time. The resolved IP is in ap_radius_ipaddr.
+	 * auth_server_hostname carries the original hostname for TLS CN/SAN. */
+	fprintf(f, "auth_server_addr=%s\n", dut->ap_radius_ipaddr);
+	fprintf(f, "auth_server_port=%d\n", dut->ap_radius_port);
+	if (hn[0])
+		fprintf(f, "auth_server_hostname=%s\n", hn);
+	fprintf(f, "auth_server_type=TLS\n");
+	if (ca[0] == '/')
+		fprintf(f, "auth_server_ca_cert=%s\n", ca);
+	else
+		fprintf(f, "auth_server_ca_cert=%s/%s\n", SIGMA_TMPDIR, ca);
+	if (cl[0]) {
+		if (cl[0] == '/') {
+			fprintf(f, "auth_server_client_cert=%s\n", cl);
+			fprintf(f, "auth_server_private_key=%s\n", cl);
+		} else {
+			fprintf(f, "auth_server_client_cert=%s/%s\n",
+				SIGMA_TMPDIR, cl);
+			fprintf(f, "auth_server_private_key=%s/%s\n",
+				SIGMA_TMPDIR, cl);
+		}
+	}
+	/* RFC 6614: RadSec shared secret must be the literal string "radsec" */
+	fprintf(f, "auth_server_shared_secret=radsec\n");
+}
